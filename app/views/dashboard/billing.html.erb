<% content_for(:title, "Billing — Starter") %>

<% content_for(:breadcrumbs) do %>
  <%= link_to "Dashboard", dashboard_path, class: "hover:text-[var(--color-fg-1200)]" %>
  <svg class="w-4 h-4 mx-1 text-[var(--color-fg-1000)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
  <span class="font-medium text-obsidian">Billing</span>
<% end %>

<% content_for(:page_header) do %>
  <h1 class="hex-h3">Billing & Subscription</h1>
  <p class="text-sm text-[var(--color-fg-1100)] mt-1">Manage your plan, payment methods, and invoices</p>
<% end %>

<%# ── Current plan ── %>
<div class="hex-card p-6 mb-4">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-sm font-semibold" style="color: var(--color-obsidian);">Current Plan</h2>
      <div class="flex items-center gap-3 mt-2">
        <span class="hex-h3">Free</span>
        <span class="px-2 py-0.5 text-xs font-medium text-[var(--color-jade)] bg-[rgba(92,177,152,0.1)] rounded-[99px]">Active</span>
      </div>
      <p class="text-sm text-[var(--color-fg-1100)] mt-1">Basic features for side projects</p>
    </div>
    <button class="btn-hex btn-hex-sm rounded-[3px]">
      Upgrade Plan
    </button>
  </div>
</div>

<div class="grid lg:grid-cols-2 gap-4">
  <%# Payment method %>
  <div class="hex-card p-6">
    <h2 class="text-base font-semibold text-obsidian mb-4">Payment Method</h2>
    <div class="flex items-center justify-between p-4 bg-[var(--color-fg-200)] border border-[var(--color-grid-500)] rounded-[6px]">
      <div class="flex items-center gap-3">
        <div class="w-10 h-7 bg-gradient-to-r from-blue-600 to-blue-400 rounded flex items-center justify-center">
          <span class="text-obsidian text-xs font-bold">VISA</span>
        </div>
        <div>
          <p class="text-sm font-medium text-obsidian">&bull;&bull;&bull;&bull; 4242</p>
          <p class="text-xs text-[var(--color-fg-1100)]">Expires 12/28</p>
        </div>
      </div>
      <button class="text-sm text-[var(--color-eggplant)] hover:text-[var(--color-amethyst)] font-medium">Update</button>
    </div>
    <p class="mt-3 text-xs text-[var(--color-fg-1000)]">No payment method required for the Free plan</p>
  </div>

  <%# Billing address %>
  <div class="hex-card p-6">
    <h2 class="text-base font-semibold text-obsidian mb-4">Billing Address</h2>
    <div class="p-4 bg-[var(--color-fg-200)] border border-[var(--color-grid-500)] rounded-[6px] text-sm text-[var(--color-fg-1200)] space-y-1">
      <p>No billing address on file</p>
    </div>
    <button class="mt-3 text-sm text-[var(--color-eggplant)] hover:text-[var(--color-amethyst)] font-medium">Add address</button>
  </div>
</div>

<%# ── Invoices ── %>
<div class="hex-card p-6 mt-4">
  <h2 class="text-base font-semibold text-obsidian mb-4">Invoices</h2>
  <div class="text-center py-12 text-[var(--color-fg-1000)]">
    <svg class="w-12 h-12 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
    <p class="text-sm">No invoices yet</p>
    <p class="text-xs text-[var(--color-fg-1000)] mt-1">Invoices will appear here after your first payment</p>
  </div>
</div>
