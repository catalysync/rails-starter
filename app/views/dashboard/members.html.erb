<% content_for(:title, "Members — Starter") %>

<% content_for(:breadcrumbs) do %>
  <%= link_to "Dashboard", dashboard_path, class: "hover:text-[var(--color-fg-1200)]" %>
  <svg class="w-4 h-4 mx-1 text-[var(--color-fg-1000)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
  <span class="font-medium text-obsidian">Members</span>
<% end %>

<% content_for(:page_header) do %>
  <div class="flex items-center justify-between">
    <div>
      <h1 class="hex-h3">Members</h1>
      <p class="text-sm text-[var(--color-fg-1100)] mt-1">Manage your team members and their roles</p>
    </div>
    <button class="btn-hex btn-hex-sm rounded-[3px]">Invite Member</button>
  </div>
<% end %>

<%# ── Members table ── %>
<div class="hex-card overflow-hidden">
  <%# Search and filter bar %>
  <div class="px-6 py-4 border-b border-[var(--color-grid-400)] flex items-center justify-between">
    <div class="relative">
      <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-[var(--color-fg-1000)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
      <input type="text" placeholder="Search members..." class="pl-9 pr-3 py-1.5 text-sm border border-[var(--color-grid-500)] rounded-[6px] focus:ring-2 focus:ring-[var(--color-amethyst)] focus:border-[var(--color-amethyst)] w-64">
    </div>
    <div class="flex items-center gap-2">
      <select class="px-3 py-1.5 text-sm border border-[var(--color-grid-500)] rounded-[6px] bg-[var(--color-fg-100)] text-[var(--color-fg-1200)]">
        <option>All roles</option>
        <option>Owner</option>
        <option>Admin</option>
        <option>Member</option>
      </select>
    </div>
  </div>

  <%# Table %>
  <table class="w-full">
    <thead>
      <tr class="border-b border-[var(--color-grid-400)]">
        <th class="px-6 py-3 text-left text-xs font-medium text-[var(--color-fg-1100)] uppercase tracking-wider">User</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-[var(--color-fg-1100)] uppercase tracking-wider">Role</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-[var(--color-fg-1100)] uppercase tracking-wider">Status</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-[var(--color-fg-1100)] uppercase tracking-wider">Joined</th>
        <th class="px-6 py-3"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% if current_account %>
        <% current_account.memberships.active.includes(:user).each do |membership| %>
          <tr class="hover:bg-[var(--color-fg-200)]">
            <td class="px-6 py-4">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-[99px] bg-[var(--color-fg-300)] flex items-center justify-center text-xs font-semibold text-[var(--color-fg-1200)]">
                  <%= membership.user.name.first.upcase %>
                </div>
                <div>
                  <p class="text-sm font-medium text-obsidian"><%= membership.user.name %></p>
                  <p class="text-xs text-[var(--color-fg-1100)]"><%= membership.user.email %></p>
                </div>
              </div>
            </td>
            <td class="px-6 py-4">
              <span class="inline-flex px-2 py-0.5 text-xs font-medium rounded-[99px]
                <%= case membership.role
                    when 'owner' then 'bg-[rgba(49,38,59,0.06)] text-[var(--color-eggplant)]'
                    when 'admin' then 'bg-[rgba(245,192,192,0.12)] text-[var(--color-amethyst)]'
                    else 'bg-[var(--color-fg-300)] text-[var(--color-fg-1200)]'
                    end %>">
                <%= membership.role.capitalize %>
              </span>
            </td>
            <td class="px-6 py-4">
              <span class="inline-flex items-center gap-1 text-xs text-[var(--color-jade)]">
                <span class="w-1.5 h-1.5 bg-[rgba(92,177,152,0.1)] rounded-[99px]"></span>
                Active
              </span>
            </td>
            <td class="px-6 py-4 text-sm text-[var(--color-fg-1100)]"><%= membership.created_at.strftime("%b %d, %Y") %></td>
            <td class="px-6 py-4 text-right">
              <button class="text-[var(--color-fg-1000)] hover:text-[var(--color-fg-1200)]">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"/></svg>
              </button>
            </td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
</div>
