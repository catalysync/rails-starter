<%# ═══ HERO ═══ %>
<section class="relative overflow-hidden">
  <%# Background grid + glow %>
  <div class="unit-grid opacity-30" style="mask-image: linear-gradient(to bottom, transparent, white 20%, white 80%, transparent);"></div>
  <div class="hex-glow"></div>

  <div class="hex-section text-center" style="padding-top: 100px; padding-bottom: 100px;">
    <a href="<%= changelog_path %>" class="hex-label inline-flex items-center gap-2 px-3 py-1 mb-8 rounded-full" style="border: 1px solid var(--color-grid-500);">
      <span class="w-1.5 h-1.5 rounded-full bg-roseQuartz"></span>
      New: Multi-tenancy & teams
    </a>

    <h1 class="hex-h1 mx-auto hex-fade-in" style="max-width: 800px;">
      Ship your SaaS
      <span class="gradient-text">in days, not months</span>
    </h1>

    <p class="hex-body mt-6 mx-auto hex-fade-in hex-fade-in-delay-1" style="max-width: 540px;">
      The production-ready Rails starter kit with authentication, billing, teams, and everything you need.
    </p>

    <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-3 hex-fade-in hex-fade-in-delay-2">
      <%= link_to new_user_registration_path, class: "btn-hex rounded-[3px]" do %>
        Get started
        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      <% end %>
      <%= link_to "See demo", dashboard_path, class: "btn-outline rounded-[3px]" %>
    </div>
  </div>
</section>

<%# ═══ LOGOS ═══ %>
<section style="border-top: 1px solid var(--color-grid-500); border-bottom: 1px solid var(--color-grid-500);">
  <div class="hex-section" style="padding-top: 40px; padding-bottom: 40px;">
    <p class="hex-label text-center mb-8">Built with</p>
    <div class="flex flex-wrap items-center justify-center gap-x-10 gap-y-4">
      <% %w[Rails Hotwire Tailwind Devise Pundit Sidekiq PostgreSQL Stripe].each do |tech| %>
        <span class="text-sm font-medium" style="color: var(--color-fg-800); letter-spacing: 0.214em; text-transform: uppercase; font-size: 11px;"><%= tech %></span>
      <% end %>
    </div>
  </div>
</section>

<%# ═══ FEATURES ═══ %>
<section id="features" class="relative">
  <div class="hex-section">
    <div class="text-center mb-16">
      <p class="hex-label mb-4" style="color: var(--color-amethyst); opacity: 1;">Features</p>
      <h2 class="hex-h2">Everything you need to launch</h2>
      <p class="hex-body mt-4">Stop building infrastructure. Start building your product.</p>
    </div>

    <div class="grid md:grid-cols-2 gap-4 mb-4">
      <div class="hex-card hex-card-noise p-8">
        <div class="w-10 h-10 rounded-lg flex items-center justify-center mb-5" style="background: rgba(49,38,59,0.04);">
          <svg class="w-5 h-5 text-roseQuartz" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
        </div>
        <h3 class="hex-h3 !text-lg mb-2">Authentication</h3>
        <p class="hex-small">Email/password, OAuth social login, password recovery, email verification, and session management with Devise.</p>
      </div>

      <div class="hex-card hex-card-noise p-8">
        <div class="w-10 h-10 rounded-lg flex items-center justify-center mb-5" style="background: rgba(49,38,59,0.06);">
          <svg class="w-5 h-5 text-amethyst" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
        </div>
        <h3 class="hex-h3 !text-lg mb-2">Multi-Tenancy & Teams</h3>
        <p class="hex-small">Personal + team accounts, membership roles, account switching, and automatic tenant scoping.</p>
      </div>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <% [
        { title: "Billing", desc: "Stripe integration with subscriptions, one-time payments, and customer portal." },
        { title: "Authorization", desc: "Pundit policies with role-based access control. Platform admin, owner, admin, member." },
        { title: "Background Jobs", desc: "Sidekiq for async processing with web UI monitoring and scheduling." },
        { title: "API Ready", desc: "Grape API with Swagger auto-docs and Scalar UI. Versioned, JSON-first." },
        { title: "Admin Dashboard", desc: "Super admin UI with user management, impersonation, and customer tracking." },
        { title: "Transactional Email", desc: "Action Mailer with letter_opener for development preview." }
      ].each do |f| %>
        <div class="hex-card p-6">
          <h3 class="text-base font-semibold mb-1" style="color: var(--color-obsidian);"><%= f[:title] %></h3>
          <p class="hex-small"><%= f[:desc] %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%# ═══ PRICING ═══ %>
<section id="pricing" style="background: #fafafa;">
  <div class="hex-section">
    <div class="text-center mb-16">
      <p class="hex-label mb-4" style="color: var(--color-amethyst); opacity: 1;">Pricing</p>
      <h2 class="hex-h2">Simple, transparent pricing</h2>
      <p class="hex-body mt-4">Choose the plan that fits your stage.</p>
    </div>
    <%= render "shared/pricing_cards" %>
  </div>
</section>

<%# ═══ TESTIMONIALS ═══ %>
<section>
  <div class="hex-section">
    <div class="text-center mb-16">
      <p class="hex-label mb-4" style="color: var(--color-amethyst); opacity: 1;">Testimonials</p>
      <h2 class="hex-h2">Loved by builders</h2>
    </div>
    <div class="grid md:grid-cols-3 gap-4">
      <% [
        { name: "Sarah Chen", role: "Founder, DataPilot", quote: "Saved us 3 weeks of setup. We went from idea to paying customers in under a month." },
        { name: "Marcus Johnson", role: "CTO, Flowbase", quote: "The multi-tenancy setup alone is worth it. We had team accounts working on day one." },
        { name: "Elena Rodriguez", role: "Indie Hacker", quote: "Finally a Rails starter that doesn't feel like 2015. Modern, clean, and actually works." }
      ].each do |t| %>
        <div class="hex-card p-6">
          <div class="flex items-center gap-1 mb-4">
            <% 5.times do %><svg class="w-3.5 h-3.5 text-roseQuartz" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg><% end %>
          </div>
          <p class="hex-small mb-5" style="color: var(--color-fg-1200);">"<%= t[:quote] %>"</p>
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-full" style="background: var(--color-fg-500);"></div>
            <div>
              <p class="text-sm font-semibold" style="color: var(--color-obsidian);"><%= t[:name] %></p>
              <p class="text-xs" style="color: var(--color-fg-1000);"><%= t[:role] %></p>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%# ═══ FAQ ═══ %>
<section id="faq" style="background: #fafafa;">
  <div class="hex-section" style="max-width: 720px;">
    <div class="text-center mb-16">
      <p class="hex-label mb-4" style="color: var(--color-amethyst); opacity: 1;">FAQ</p>
      <h2 class="hex-h2">Frequently asked questions</h2>
    </div>
    <div class="space-y-3">
      <% [
        { q: "What do I get?", a: "A complete Rails 8 app with auth, multi-tenancy, billing, admin dashboard, API, background jobs, and production deployment." },
        { q: "Is this just a template?", a: "Fully functional with real business logic, specs, policies, and error handling." },
        { q: "Can I use it commercially?", a: "Yes. Perpetual license for unlimited commercial projects." },
        { q: "What about updates?", a: "Lifetime access — new features, security patches, and Rails upgrades." }
      ].each do |faq| %>
        <details class="group hex-card overflow-hidden">
          <summary class="flex items-center justify-between px-6 py-4 cursor-pointer hex-small !font-medium hex-ease" style="color: var(--color-obsidian);">
            <%= faq[:q] %>
            <svg class="w-4 h-4 group-open:rotate-180 transition-transform shrink-0 ml-4" style="color: var(--color-fg-900);" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-6 pb-4 hex-small"><%= faq[:a] %></div>
        </details>
      <% end %>
    </div>
  </div>
</section>

<%# ═══ CTA ═══ %>
<section class="relative">
  <div class="hex-glow"></div>
  <div class="hex-section text-center" style="max-width: 720px;">
    <h2 class="hex-h2 mb-4">Ready to ship?</h2>
    <p class="hex-body mb-10 mx-auto" style="max-width: 480px;">Stop rebuilding auth, billing, and teams. Start building what makes your product unique.</p>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
      <%= link_to new_user_registration_path, class: "btn-hex rounded-[3px]" do %>
        Get started
        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      <% end %>
      <%= link_to "View pricing", pricing_path, class: "btn-outline rounded-[3px]" %>
    </div>
  </div>
</section>
