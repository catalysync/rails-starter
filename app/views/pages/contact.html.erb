<% content_for(:title, "Contact — Starter") %>

<section class="py-20 sm:py-28">
  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <p class="text-sm font-semibold text-[var(--color-eggplant)] uppercase tracking-wider mb-3">Contact</p>
      <h1 class="text-3xl sm:text-4xl font-bold text-[var(--color-obsidian)]">Get in touch</h1>
      <p class="mt-4 text-lg text-[var(--color-fg-1100)]">Have questions? We'd love to hear from you.</p>
    </div>

    <div class="hex-card border border-[var(--color-grid-400)] rounded-2xl p-8">
      <%# Placeholder contact form — wire up to a mailer or external service %>
      <form class="space-y-6">
        <div class="grid sm:grid-cols-2 gap-6">
          <div>
            <label for="contact_name" class="block text-sm font-medium text-[var(--color-fg-1200)] mb-1">Name</label>
            <input type="text" id="contact_name" name="name" placeholder="Your name"
                   class="w-full px-3 py-2 border border-[var(--color-grid-500)] rounded-lg focus:ring-2 focus:ring-[var(--color-amethyst)] focus:border-[var(--color-amethyst)] text-sm">
          </div>
          <div>
            <label for="contact_email" class="block text-sm font-medium text-[var(--color-fg-1200)] mb-1">Email</label>
            <input type="email" id="contact_email" name="email" placeholder="you@example.com"
                   class="w-full px-3 py-2 border border-[var(--color-grid-500)] rounded-lg focus:ring-2 focus:ring-[var(--color-amethyst)] focus:border-[var(--color-amethyst)] text-sm">
          </div>
        </div>

        <div>
          <label for="contact_subject" class="block text-sm font-medium text-[var(--color-fg-1200)] mb-1">Subject</label>
          <input type="text" id="contact_subject" name="subject" placeholder="What's this about?"
                 class="w-full px-3 py-2 border border-[var(--color-grid-500)] rounded-lg focus:ring-2 focus:ring-[var(--color-amethyst)] focus:border-[var(--color-amethyst)] text-sm">
        </div>

        <div>
          <label for="contact_message" class="block text-sm font-medium text-[var(--color-fg-1200)] mb-1">Message</label>
          <textarea id="contact_message" name="message" rows="5" placeholder="Tell us more..."
                    class="w-full px-3 py-2 border border-[var(--color-grid-500)] rounded-lg focus:ring-2 focus:ring-[var(--color-amethyst)] focus:border-[var(--color-amethyst)] text-sm resize-none"></textarea>
        </div>

        <button type="submit" class="w-full py-2.5 text-sm font-medium text-white bg-[var(--color-eggplant)] rounded-lg hover:opacity-90 transition-colors">
          Send Message
        </button>
      </form>
    </div>
  </div>
</section>
