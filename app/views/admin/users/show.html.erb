<% content_for(:title, "User Details — Admin") %>

<% content_for(:breadcrumbs) do %>
  <%= link_to "Admin", admin_dashboard_path, class: "hover:text-[var(--color-fg-1200)]" %>
  <svg class="w-4 h-4 mx-1 text-[var(--color-fg-1000)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
  <%= link_to "Users", admin_users_path, class: "hover:text-[var(--color-fg-1200)]" %>
  <svg class="w-4 h-4 mx-1 text-[var(--color-fg-1000)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
  <span class="font-medium text-obsidian">User Details</span>
<% end %>

<% content_for(:page_header) do %>
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-4">
      <div class="w-14 h-14 rounded-[99px] bg-[var(--color-fg-300)] flex items-center justify-center text-xl font-bold text-[var(--color-fg-1000)]">?</div>
      <div>
        <h1 class="hex-h3">User Details</h1>
        <p class="text-sm text-[var(--color-fg-1100)]">Manage this user's profile, roles, and access</p>
      </div>
    </div>
    <div class="flex items-center gap-2">
      <button class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-[var(--color-citrine)] bg-[rgba(205,168,73,0.1)] border border-[rgba(205,168,73,0.2)] rounded-[6px] hover:bg-[rgba(205,168,73,0.15)] transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
        Impersonate
      </button>
    </div>
  </div>
<% end %>

<div class="grid lg:grid-cols-3 gap-4">
  <%# ── Main content ── %>
  <div class="lg:col-span-2 space-y-6">
    <%# Profile card %>
    <div class="hex-card p-6">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-sm font-semibold" style="color: var(--color-obsidian);">Profile Information</h2>
        <button class="text-xs text-[var(--color-eggplant)] hover:text-[var(--color-amethyst)] font-medium">Edit</button>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <% [
          { label: "First Name", value: "—" },
          { label: "Last Name", value: "—" },
          { label: "Email", value: "—", full: true },
          { label: "Platform Admin", value: "—" },
          { label: "2FA Enabled", value: "—" },
          { label: "Created", value: "—" },
          { label: "Last Updated", value: "—" },
          { label: "Sign-in Count", value: "—" },
          { label: "Last Sign-in", value: "—" },
          { label: "Last Sign-in IP", value: "—" }
        ].each do |field| %>
          <div class="<%= 'col-span-2' if field[:full] %> py-2 border-b border-[var(--color-grid-400)]">
            <dt class="text-xs text-[var(--color-fg-1000)] mb-0.5"><%= field[:label] %></dt>
            <dd class="text-sm font-medium text-obsidian"><%= field[:value] %></dd>
          </div>
        <% end %>
      </div>
    </div>

    <%# Memberships %>
    <div class="hex-card p-6">
      <h2 class="text-base font-semibold text-obsidian mb-4">Account Memberships</h2>
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr class="border-b border-[var(--color-grid-400)]">
              <th class="py-2 text-left text-xs font-medium text-[var(--color-fg-1100)] uppercase">Account</th>
              <th class="py-2 text-left text-xs font-medium text-[var(--color-fg-1100)] uppercase">Type</th>
              <th class="py-2 text-left text-xs font-medium text-[var(--color-fg-1100)] uppercase">Role</th>
              <th class="py-2 text-left text-xs font-medium text-[var(--color-fg-1100)] uppercase">Status</th>
              <th class="py-2 text-left text-xs font-medium text-[var(--color-fg-1100)] uppercase">Joined</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-50">
            <tr>
              <td colspan="5" class="py-8 text-center text-sm text-[var(--color-fg-1000)]">Membership data loads from database</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <%# Connected accounts %>
    <div class="hex-card p-6">
      <h2 class="text-base font-semibold text-obsidian mb-4">Connected Accounts</h2>
      <div class="text-center py-8 text-sm text-[var(--color-fg-1000)]">
        <p>No connected OAuth accounts</p>
        <p class="text-xs mt-1">OAuth connections will appear here once configured (Phase 2)</p>
      </div>
    </div>

    <%# Subscriptions %>
    <div class="hex-card p-6">
      <h2 class="text-base font-semibold text-obsidian mb-4">Billing & Subscriptions</h2>
      <div class="text-center py-8 text-sm text-[var(--color-fg-1000)]">
        <p>No active subscriptions</p>
        <p class="text-xs mt-1">Subscription data will appear once Stripe is integrated</p>
      </div>
    </div>
  </div>

  <%# ── Sidebar: actions ── %>
  <div class="space-y-6">
    <%# Quick actions %>
    <div class="hex-card p-5">
      <h2 class="text-base font-semibold text-obsidian mb-3">Actions</h2>
      <div class="space-y-1">
        <button class="w-full flex items-center gap-3 px-3 py-2.5 text-sm text-left text-[var(--color-fg-1200)] rounded-[6px] hover:bg-[var(--color-fg-200)] transition-colors">
          <svg class="w-4 h-4 text-[var(--color-fg-1000)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
          Impersonate User
        </button>
        <button class="w-full flex items-center gap-3 px-3 py-2.5 text-sm text-left text-[var(--color-fg-1200)] rounded-[6px] hover:bg-[var(--color-fg-200)] transition-colors">
          <svg class="w-4 h-4 text-[var(--color-fg-1000)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
          Reset Password
        </button>
        <button class="w-full flex items-center gap-3 px-3 py-2.5 text-sm text-left text-[var(--color-fg-1200)] rounded-[6px] hover:bg-[var(--color-fg-200)] transition-colors">
          <svg class="w-4 h-4 text-[var(--color-fg-1000)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          Toggle Platform Admin
        </button>
        <button class="w-full flex items-center gap-3 px-3 py-2.5 text-sm text-left text-[var(--color-fg-1200)] rounded-[6px] hover:bg-[var(--color-fg-200)] transition-colors">
          <svg class="w-4 h-4 text-[var(--color-fg-1000)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
          Disable 2FA
        </button>
      </div>
    </div>

    <%# Danger zone %>
    <div class="bg-[var(--color-fg-100)] border border-[var(--color-roseQuartz)] rounded-[12px] p-5">
      <h2 class="text-base font-semibold text-[#c24040] mb-3">Danger Zone</h2>
      <div class="space-y-1">
        <button class="w-full flex items-center gap-3 px-3 py-2.5 text-sm text-left text-[var(--color-citrine)] rounded-[6px] hover:bg-[rgba(205,168,73,0.1)] transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/></svg>
          Ban User
        </button>
        <button class="w-full flex items-center gap-3 px-3 py-2.5 text-sm text-left text-[#c24040] rounded-[6px] hover:bg-[rgba(245,192,192,0.12)] transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
          Delete User Permanently
        </button>
      </div>
      <p class="text-xs text-[var(--color-fg-1000)] mt-3">Deleting a user removes all their data, memberships, and owned accounts. This cannot be undone.</p>
    </div>

    <%# Activity log %>
    <div class="hex-card p-5">
      <h2 class="text-base font-semibold text-obsidian mb-3">Activity Log</h2>
      <div class="text-center py-6 text-xs text-[var(--color-fg-1000)]">
        <p>Activity log powered by PaperTrail</p>
        <p class="mt-1">Audit trail will appear here</p>
      </div>
    </div>
  </div>
</div>
