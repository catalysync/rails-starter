<% content_for(:title, "Organization Details — Admin") %>

<% content_for(:breadcrumbs) do %>
  <%= link_to "Admin", admin_dashboard_path, class: "hover:text-[var(--color-fg-1200)]" %>
  <svg class="w-4 h-4 mx-1 text-[var(--color-fg-1000)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
  <%= link_to "Organizations", admin_accounts_path, class: "hover:text-[var(--color-fg-1200)]" %>
  <svg class="w-4 h-4 mx-1 text-[var(--color-fg-1000)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
  <span class="font-medium text-obsidian">Details</span>
<% end %>

<% content_for(:page_header) do %>
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-4">
      <div class="w-14 h-14 rounded-[12px] bg-gradient-to-br from-blue-500 to-blue-600 flex items-center justify-center text-xl font-bold text-obsidian">?</div>
      <div>
        <h1 class="hex-h3">Organization Details</h1>
        <p class="text-sm text-[var(--color-fg-1100)]">View and manage this organization</p>
      </div>
    </div>
    <button class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-[var(--color-citrine)] bg-[rgba(205,168,73,0.1)] border border-[rgba(205,168,73,0.2)] rounded-[6px] hover:bg-[rgba(205,168,73,0.15)] transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
      Impersonate Admin
    </button>
  </div>
<% end %>

<div class="grid lg:grid-cols-3 gap-4">
  <div class="lg:col-span-2 space-y-6">
    <%# Details %>
    <div class="hex-card p-6">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-sm font-semibold" style="color: var(--color-obsidian);">Organization Information</h2>
        <button class="text-xs text-[var(--color-eggplant)] hover:text-[var(--color-amethyst)] font-medium">Edit</button>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <% [
          { label: "Name", value: "—" },
          { label: "Type", value: "—" },
          { label: "Slug / Subdomain", value: "—" },
          { label: "Custom Domain", value: "—" },
          { label: "Owner", value: "—" },
          { label: "Billing Email", value: "—" },
          { label: "Stripe Customer ID", value: "—" },
          { label: "Created", value: "—" },
          { label: "Members", value: "—" },
          { label: "Last Updated", value: "—" }
        ].each do |field| %>
          <div class="py-2 border-b border-[var(--color-grid-400)]">
            <dt class="text-xs text-[var(--color-fg-1000)] mb-0.5"><%= field[:label] %></dt>
            <dd class="text-sm font-medium text-obsidian"><%= field[:value] %></dd>
          </div>
        <% end %>
      </div>
    </div>

    <%# Members table %>
    <div class="hex-card p-6">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-sm font-semibold" style="color: var(--color-obsidian);">Members</h2>
        <button class="px-3 py-1.5 text-xs font-medium text-[var(--color-eggplant)] bg-[rgba(245,192,192,0.12)] rounded-[6px] hover:bg-[rgba(49,38,59,0.08)] transition-colors">Invite Member</button>
      </div>
      <table class="w-full">
        <thead>
          <tr class="border-b border-[var(--color-grid-400)]">
            <th class="py-2 text-left text-xs font-medium text-[var(--color-fg-1100)] uppercase">User</th>
            <th class="py-2 text-left text-xs font-medium text-[var(--color-fg-1100)] uppercase">Role</th>
            <th class="py-2 text-left text-xs font-medium text-[var(--color-fg-1100)] uppercase">Status</th>
            <th class="py-2 text-left text-xs font-medium text-[var(--color-fg-1100)] uppercase">Joined</th>
            <th class="py-2"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-50">
          <tr>
            <td colspan="5" class="py-8 text-center text-sm text-[var(--color-fg-1000)]">Member data loads from database</td>
          </tr>
        </tbody>
      </table>
    </div>

    <%# Pending invitations %>
    <div class="hex-card p-6">
      <h2 class="text-base font-semibold text-obsidian mb-4">Pending Invitations</h2>
      <div class="text-center py-6 text-sm text-[var(--color-fg-1000)]">
        <p>No pending invitations</p>
        <p class="text-xs mt-1">Invitations feature coming in Phase 2</p>
      </div>
    </div>

    <%# Activity audit %>
    <div class="hex-card p-6">
      <h2 class="text-base font-semibold text-obsidian mb-4">Activity History</h2>
      <div class="text-center py-6 text-sm text-[var(--color-fg-1000)]">
        <p>Activity audit powered by PaperTrail</p>
        <p class="text-xs mt-1">Change history will appear here</p>
      </div>
    </div>
  </div>

  <%# Sidebar %>
  <div class="space-y-6">
    <div class="hex-card p-5">
      <h2 class="text-base font-semibold text-obsidian mb-3">Actions</h2>
      <div class="space-y-1">
        <button class="w-full flex items-center gap-3 px-3 py-2.5 text-sm text-left text-[var(--color-fg-1200)] rounded-[6px] hover:bg-[var(--color-fg-200)] transition-colors">
          <svg class="w-4 h-4 text-[var(--color-fg-1000)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
          Impersonate Admin
        </button>
        <button class="w-full flex items-center gap-3 px-3 py-2.5 text-sm text-left text-[var(--color-fg-1200)] rounded-[6px] hover:bg-[var(--color-fg-200)] transition-colors">
          <svg class="w-4 h-4 text-[var(--color-fg-1000)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
          Transfer Ownership
        </button>
        <button class="w-full flex items-center gap-3 px-3 py-2.5 text-sm text-left text-[var(--color-fg-1200)] rounded-[6px] hover:bg-[var(--color-fg-200)] transition-colors">
          <svg class="w-4 h-4 text-[var(--color-fg-1000)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
          Edit Details
        </button>
      </div>
    </div>

    <%# Metadata / settings JSONB %>
    <div class="hex-card p-5">
      <h2 class="text-base font-semibold text-obsidian mb-3">Settings (JSONB)</h2>
      <pre class="text-xs text-[var(--color-fg-1100)] bg-[var(--color-fg-200)] rounded-[6px] p-3 overflow-x-auto">{}</pre>
    </div>

    <%# Danger zone %>
    <div class="bg-[var(--color-fg-100)] border border-[var(--color-roseQuartz)] rounded-[12px] p-5">
      <h2 class="text-base font-semibold text-[#c24040] mb-3">Danger Zone</h2>
      <button class="w-full flex items-center gap-3 px-3 py-2.5 text-sm text-left text-[#c24040] rounded-[6px] hover:bg-[rgba(245,192,192,0.12)] transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
        Delete Organization
      </button>
      <p class="text-xs text-[var(--color-fg-1000)] mt-3">Removes the organization, all memberships, and tenant-scoped data permanently.</p>
    </div>
  </div>
</div>
