<%# Reusable Data Table — pass search_placeholder, filters, columns, rows, empty_message, empty_detail, count %>

<% search_placeholder ||= "Search..." %>
<% filters ||= [] %>
<% columns ||= [] %>
<% empty_message ||= "No records found" %>
<% empty_detail ||= nil %>
<% count ||= nil %>

<div class="hex-card overflow-hidden">
  <%# ── Toolbar: search + filters ── %>
  <div class="px-4 sm:px-6 py-4 border-b border-[var(--color-grid-400)] flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
    <div class="flex items-center gap-3 w-full sm:w-auto">
      <div class="relative flex-1 sm:flex-initial">
        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-[var(--color-fg-1000)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        <input type="text" placeholder="<%= search_placeholder %>"
               class="w-full sm:w-64 pl-9 pr-3 py-1.5 text-sm border border-[var(--color-grid-500)] rounded-[6px] focus:ring-2 focus:ring-[var(--color-amethyst)] focus:border-[var(--color-amethyst)]">
      </div>
      <% if count %>
        <span class="text-xs text-[var(--color-fg-1000)] whitespace-nowrap"><%= count %> total</span>
      <% end %>
    </div>

    <div class="flex items-center gap-2 w-full sm:w-auto">
      <% filters.each do |filter| %>
        <select name="<%= filter[:name] %>"
                class="px-3 py-1.5 text-sm border border-[var(--color-grid-500)] rounded-[6px] bg-[var(--color-fg-100)] text-[var(--color-fg-1200)] w-full sm:w-auto">
          <% filter[:options].each do |option| %>
            <option><%= option %></option>
          <% end %>
        </select>
      <% end %>
    </div>
  </div>

  <%# ── Table ── %>
  <div class="overflow-x-auto">
    <table class="w-full">
      <% if columns.any? %>
        <thead>
          <tr class="border-b border-[var(--color-grid-400)]">
            <% columns.each do |col| %>
              <th class="px-4 sm:px-6 py-3 text-left text-xs font-medium text-[var(--color-fg-1100)] uppercase tracking-wider whitespace-nowrap">
                <% if col.is_a?(Hash) %>
                  <button class="inline-flex items-center gap-1 hover:text-[var(--color-fg-1200)] transition-colors">
                    <%= col[:label] %>
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"/></svg>
                  </button>
                <% else %>
                  <%= col %>
                <% end %>
              </th>
            <% end %>
          </tr>
        </thead>
      <% end %>

      <tbody class="divide-y divide-gray-100">
        <% if local_assigns[:rows].present? %>
          <%= rows %>
        <% else %>
          <tr>
            <td colspan="<%= [columns.size, 1].max %>" class="px-6 py-16 text-center">
              <div class="text-[var(--color-fg-1000)]">
                <svg class="w-10 h-10 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/></svg>
                <p class="text-sm font-medium"><%= empty_message %></p>
                <% if empty_detail %>
                  <p class="text-xs mt-1"><%= empty_detail %></p>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%# ── Pagination (placeholder) ── %>
  <div class="px-4 sm:px-6 py-3 border-t border-[var(--color-grid-400)] flex items-center justify-between">
    <p class="text-xs text-[var(--color-fg-1100)]">Showing <span class="font-medium">1-10</span> of <span class="font-medium"><%= count || "—" %></span></p>
    <div class="flex items-center gap-1">
      <button class="px-2.5 py-1 text-xs font-medium text-[var(--color-fg-1000)] bg-[var(--color-fg-200)] border border-[var(--color-grid-500)] rounded-md cursor-not-allowed" disabled>Previous</button>
      <button class="px-2.5 py-1 text-xs font-medium text-[var(--color-eggplant)] bg-[rgba(245,192,192,0.12)] border border-[rgba(245,192,192,0.3)] rounded-md">1</button>
      <button class="px-2.5 py-1 text-xs font-medium text-[var(--color-fg-1200)] hex-card rounded-md hover:bg-[var(--color-fg-200)]">2</button>
      <button class="px-2.5 py-1 text-xs font-medium text-[var(--color-fg-1200)] hex-card rounded-md hover:bg-[var(--color-fg-200)]">Next</button>
    </div>
  </div>
</div>
