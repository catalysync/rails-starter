<header class="sticky top-0 z-20 h-16 backdrop-blur-xl flex items-center justify-between px-4 sm:px-6 lg:px-8" style="background: rgba(255,255,255,0.8); border-bottom: 1px solid var(--color-grid-500);">
  <div class="flex items-center gap-3">
    <button data-action="click->sidebar#open" class="lg:hidden p-2 -ml-2 rounded-lg hover:bg-[var(--color-fg-300)] transition-colors" style="color: var(--color-fg-1000);">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>
    <% if content_for?(:breadcrumbs) %>
      <nav class="flex items-center text-sm" style="color: var(--color-text-muted);"><%= yield :breadcrumbs %></nav>
    <% end %>
  </div>
  <div class="flex items-center gap-3">
    <button class="hidden sm:flex items-center gap-2 px-3 py-1.5 text-sm rounded-lg transition-colors" style="color: var(--color-fg-1000); background: var(--color-fg-300); border: 1px solid var(--color-grid-400);">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
      <span>Search...</span>
      <kbd class="hidden lg:inline-flex items-center px-1.5 py-0.5 font-mono text-[10px] rounded" style="color: var(--color-fg-1000); background: var(--color-fg-100); border: 1px solid var(--color-grid-400);">&#8984;K</kbd>
    </button>
    <button class="relative p-2 rounded-lg hover:bg-[var(--color-fg-300)] transition-colors" style="color: var(--color-fg-1000);">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
      <span class="absolute top-1.5 right-1.5 w-2 h-2 rounded-full" style="background: var(--color-roseQuartz);"></span>
    </button>
  </div>
</header>
