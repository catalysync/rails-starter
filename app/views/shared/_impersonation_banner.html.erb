<%# Shown at the top of the page when an admin is impersonating a user %>
<% if session[:impersonating_user_id].present? %>
  <div class="bg-amber-500 text-white">
    <div class="max-w-7xl mx-auto px-4 py-2 flex items-center justify-between">
      <div class="flex items-center gap-2 text-sm font-medium">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        You are impersonating <strong class="mx-1"><%= current_user.name %></strong> (<%= current_user.email %>)
      </div>
      <button class="inline-flex items-center gap-1 px-3 py-1 text-xs font-medium text-amber-900 bg-white/90 rounded-full hover:bg-white transition-colors">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
        Stop Impersonating
      </button>
    </div>
  </div>
<% end %>
