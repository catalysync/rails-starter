<footer class="relative z-10" style="border-top: 1px solid var(--color-grid-500); background: #fafafa;">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-8">
      <div class="col-span-2 lg:col-span-1">
        <div class="flex items-center gap-2.5 mb-4">
          <div class="w-7 h-7 rounded-lg bg-gradient-to-br from-roseQuartz to-eggplant flex items-center justify-center">
            <span class="text-white font-bold text-xs">S</span>
          </div>
          <span class="font-display text-base font-bold tracking-tight" style="color: var(--color-obsidian);">Starter</span>
        </div>
        <p class="text-sm leading-relaxed" style="color: var(--color-text-muted);">Ship your SaaS faster with the Rails starter kit that does the boring stuff for you.</p>
      </div>
      <% [
        { title: "Product", links: [["Features", landing_path(anchor: "features")], ["Pricing", pricing_path], ["Changelog", changelog_path], ["API Docs", "/docs"]] },
        { title: "Resources", links: [["Blog", blog_index_path], ["Contact", contact_path]] },
        { title: "Legal", links: [["Privacy Policy", privacy_path], ["Terms of Service", terms_path]] }
      ].each do |col| %>
        <div>
          <h3 class="hex-label mb-4"><%= col[:title] %></h3>
          <ul class="space-y-2.5 text-sm">
            <% col[:links].each do |label, path| %>
              <li><%= link_to label, path, class: "transition-colors", style: "color: var(--color-text-muted);" %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
    <div class="mt-12 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4" style="border-top: 1px solid var(--color-grid-500);">
      <p class="text-xs" style="color: var(--color-fg-1000);">&copy; <%= Date.current.year %> Starter. All rights reserved.</p>
      <div class="flex items-center gap-4">
        <a href="#" style="color: var(--color-grid-700);" aria-label="X/Twitter"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg></a>
        <a href="#" style="color: var(--color-grid-700);" aria-label="GitHub"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg></a>
      </div>
    </div>
  </div>
</footer>
