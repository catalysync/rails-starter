<header class="sticky top-0 z-50 backdrop-blur-xl" style="background-color: rgba(255,255,255,0.8); border-bottom: 1px solid var(--color-grid-500);">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <%= link_to root_path, class: "flex items-center gap-2.5" do %>
        <div class="w-7 h-7 rounded-lg bg-gradient-to-br from-roseQuartz to-eggplant flex items-center justify-center">
          <span class="text-white font-bold text-xs">S</span>
        </div>
        <span class="font-display text-base font-bold tracking-tight" style="color: var(--color-obsidian);">Starter</span>
      <% end %>

      <nav class="hidden md:flex items-center gap-1">
        <% %w[Features Pricing Blog Docs].each do |item| %>
          <% path = case item
               when "Features" then landing_path(anchor: "features")
               when "Pricing" then pricing_path
               when "Blog" then blog_index_path
               when "Docs" then "/docs"
             end %>
          <%= link_to item, path, class: "px-3 py-2 text-sm rounded-lg transition-colors", style: "color: var(--color-text-muted);" %>
        <% end %>
      </nav>

      <div class="flex items-center gap-3">
        <% if user_signed_in? %>
          <%= link_to "Dashboard", dashboard_path, class: "btn-hex px-4 py-2 text-sm font-medium rounded-lg" %>
        <% else %>
          <%= link_to "Log in", new_user_session_path, class: "hidden sm:inline-flex px-3 py-2 text-sm transition-colors", style: "color: var(--color-text-muted);" %>
          <%= link_to "Get started", new_user_registration_path, class: "btn-hex px-4 py-2 text-sm font-medium rounded-lg" %>
        <% end %>
      </div>
    </div>
  </div>
</header>
