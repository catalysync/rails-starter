<h2 class="text-2xl font-display font-bold text-center mb-2" style="color: var(--color-obsidian);">Welcome back</h2>
<p class="text-sm text-center mb-8" style="color: var(--color-text-muted);">Sign in to your account to continue</p>

<div class="space-y-3 mb-6">
  <button type="button" class="w-full flex items-center justify-center gap-3 px-4 py-2.5 text-sm font-medium rounded-lg transition-colors" style="border: 1px solid var(--color-grid-500); color: var(--color-fg-1200);">
    <svg class="w-5 h-5" viewBox="0 0 24 24"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
    Continue with Google
  </button>
  <button type="button" class="w-full flex items-center justify-center gap-3 px-4 py-2.5 text-sm font-medium rounded-lg transition-colors" style="border: 1px solid var(--color-grid-500); color: var(--color-fg-1200);">
    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
    Continue with GitHub
  </button>
</div>

<div class="relative mb-6">
  <div class="absolute inset-0 flex items-center"><div class="w-full" style="border-top: 1px solid var(--color-grid-400);"></div></div>
  <div class="relative flex justify-center"><span class="hex-label px-3" style="background: rgba(255,252,252,0.7);">or</span></div>
</div>

<%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
  <div class="space-y-4">
    <div>
      <%= f.label :email, class: "block text-sm font-medium mb-1", style: "color: var(--color-fg-1200);" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "you@example.com",
          class: "w-full px-3 py-2.5 text-sm rounded-lg", style: "border: 1px solid var(--color-grid-500); color: var(--color-obsidian); background: var(--color-fg-200);" %>
    </div>

    <div>
      <div class="flex items-center justify-between mb-1">
        <%= f.label :password, class: "block text-sm font-medium", style: "color: var(--color-fg-1200);" %>
        <%= link_to "Forgot password?", new_password_path(resource_name), class: "text-xs font-medium", style: "color: var(--color-eggplant);" %>
      </div>
      <%= f.password_field :password, autocomplete: "current-password", placeholder: "Enter your password",
          class: "w-full px-3 py-2.5 text-sm rounded-lg", style: "border: 1px solid var(--color-grid-500); color: var(--color-obsidian); background: var(--color-fg-200);" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <label class="flex items-center gap-2 cursor-pointer">
        <%= f.check_box :remember_me, class: "w-4 h-4 rounded", style: "border-color: var(--color-grid-500);" %>
        <span class="text-sm" style="color: var(--color-text-muted);">Remember me</span>
      </label>
    <% end %>

    <%= f.submit "Sign in", class: "w-full py-2.5 text-sm font-medium btn-hex rounded-lg cursor-pointer" %>
  </div>
<% end %>

<p class="mt-6 text-center text-sm" style="color: var(--color-text-muted);">
  Don't have an account?
  <%= link_to "Sign up", new_registration_path(resource_name), class: "font-medium", style: "color: var(--color-eggplant);" %>
</p>
