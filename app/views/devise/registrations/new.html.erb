<h2 class="text-2xl font-display text-[var(--color-obsidian)] text-center mb-2">Create your account</h2>
<p class="text-sm text-[var(--color-fg-1100)] text-center mb-8">Start building your SaaS in minutes</p>

<%# ── OAuth buttons ── %>
<div class="space-y-3 mb-6">
  <button type="button" class="w-full flex items-center justify-center gap-3 px-4 py-2.5 text-sm font-medium text-[var(--color-fg-1100)] border border-[var(--color-grid-500)] rounded-lg hover:bg-[var(--color-fg-300)] transition-colors">
    <svg class="w-5 h-5" viewBox="0 0 24 24"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
    Continue with Google
  </button>
  <button type="button" class="w-full flex items-center justify-center gap-3 px-4 py-2.5 text-sm font-medium text-[var(--color-fg-1100)] border border-[var(--color-grid-500)] rounded-lg hover:bg-[var(--color-fg-300)] transition-colors">
    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
    Continue with GitHub
  </button>
</div>

<div class="relative mb-6">
  <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-[var(--color-grid-500)]"></div></div>
  <div class="relative flex justify-center text-xs"><span class="px-3 bg-[var(--color-fg-200)] text-[var(--color-fg-1100)] font-mono uppercase tracking-wider">or</span></div>
</div>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), data: { turbo: false }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="space-y-4">
    <div class="grid grid-cols-2 gap-3">
      <div>
        <%= f.label :first_name, class: "block text-sm font-medium text-[var(--color-fg-1100)] mb-1" %>
        <%= f.text_field :first_name, autofocus: true, placeholder: "First name",
            class: "w-full px-3 py-2.5 text-sm bg-[var(--color-fg-300)] border border-[var(--color-grid-500)] rounded-lg text-[var(--color-obsidian)] placeholder-[var(--color-fg-900)] focus:ring-2 focus:ring-[var(--color-amethyst)] focus:border-[var(--color-amethyst)]" %>
      </div>
      <div>
        <%= f.label :last_name, class: "block text-sm font-medium text-[var(--color-fg-1100)] mb-1" %>
        <%= f.text_field :last_name, placeholder: "Last name",
            class: "w-full px-3 py-2.5 text-sm bg-[var(--color-fg-300)] border border-[var(--color-grid-500)] rounded-lg text-[var(--color-obsidian)] placeholder-[var(--color-fg-900)] focus:ring-2 focus:ring-[var(--color-amethyst)] focus:border-[var(--color-amethyst)]" %>
      </div>
    </div>

    <div>
      <%= f.label :email, class: "block text-sm font-medium text-[var(--color-fg-1100)] mb-1" %>
      <%= f.email_field :email, autocomplete: "email", placeholder: "you@example.com",
          class: "w-full px-3 py-2.5 text-sm bg-[var(--color-fg-300)] border border-[var(--color-grid-500)] rounded-lg text-[var(--color-obsidian)] placeholder-[var(--color-fg-900)] focus:ring-2 focus:ring-[var(--color-amethyst)] focus:border-[var(--color-amethyst)]" %>
    </div>

    <div>
      <%= f.label :password, class: "block text-sm font-medium text-[var(--color-fg-1100)] mb-1" %>
      <% if @minimum_password_length %>
        <p class="text-xs text-[var(--color-fg-1100)] mb-1"><%= @minimum_password_length %> characters minimum</p>
      <% end %>
      <%= f.password_field :password, autocomplete: "new-password", placeholder: "Create a password",
          class: "w-full px-3 py-2.5 text-sm bg-[var(--color-fg-300)] border border-[var(--color-grid-500)] rounded-lg text-[var(--color-obsidian)] placeholder-[var(--color-fg-900)] focus:ring-2 focus:ring-[var(--color-amethyst)] focus:border-[var(--color-amethyst)]" %>
    </div>

    <div>
      <%= f.label :password_confirmation, "Confirm password", class: "block text-sm font-medium text-[var(--color-fg-1100)] mb-1" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "Confirm your password",
          class: "w-full px-3 py-2.5 text-sm bg-[var(--color-fg-300)] border border-[var(--color-grid-500)] rounded-lg text-[var(--color-obsidian)] placeholder-[var(--color-fg-900)] focus:ring-2 focus:ring-[var(--color-amethyst)] focus:border-[var(--color-amethyst)]" %>
    </div>

    <%= f.submit "Create Account", class: "w-full py-2.5 text-sm font-medium btn-hex rounded-lg cursor-pointer" %>
  </div>
<% end %>

<p class="mt-6 text-center text-sm text-[var(--color-fg-1100)]">
  Already have an account?
  <%= link_to "Sign in", new_session_path(resource_name), class: "text-[var(--color-eggplant)] hover:text-[var(--color-amethyst)] font-medium transition-colors" %>
</p>
