<% content_for(:title, "Notifications — Starter") %>

<% content_for(:breadcrumbs) do %>
  <%= link_to "Dashboard", dashboard_path, class: "hover:text-[var(--color-fg-1200)]" %>
  <svg class="w-4 h-4 mx-1 text-[var(--color-fg-1000)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
  <span class="font-medium text-obsidian">Notifications</span>
<% end %>

<% content_for(:page_header) do %>
  <h1 class="hex-h3">Notification Preferences</h1>
  <p class="text-sm text-[var(--color-fg-1100)] mt-1">Choose how and when you receive notifications</p>
<% end %>

<%# ── Settings tabs ── %>
<div class="mb-8" style="border-bottom: 1px solid var(--color-grid-500);">
  <nav class="flex gap-4 -mb-px">
    <%= link_to "General", dashboard_settings_general_path, class: "pb-3 text-sm font-medium border-b-2 #{current_page?(dashboard_settings_general_path) ? 'border-[var(--color-eggplant)] text-[var(--color-eggplant)]' : 'border-transparent text-[var(--color-fg-1000)] hover:text-[var(--color-obsidian)]'} transition-colors" %>
    <%= link_to "Profile", dashboard_settings_profile_path, class: "pb-3 text-sm font-medium border-b-2 #{current_page?(dashboard_settings_profile_path) ? 'border-[var(--color-eggplant)] text-[var(--color-eggplant)]' : 'border-transparent text-[var(--color-fg-1000)] hover:text-[var(--color-obsidian)]'} transition-colors" %>
    <%= link_to "Notifications", dashboard_settings_notifications_path, class: "pb-3 text-sm font-medium border-b-2 #{current_page?(dashboard_settings_notifications_path) ? 'border-[var(--color-eggplant)] text-[var(--color-eggplant)]' : 'border-transparent text-[var(--color-fg-1000)] hover:text-[var(--color-obsidian)]'} transition-colors" %>
  </nav>
</div>

<div class="hex-card divide-y divide-gray-100">
  <% [
    { title: "New member joins", description: "When someone accepts an invitation to your account", email: true, push: true },
    { title: "Member removed", description: "When a member is removed from your account", email: true, push: false },
    { title: "Role changes", description: "When a member's role is changed", email: false, push: true },
    { title: "Billing alerts", description: "Payment failures, subscription changes, and invoices", email: true, push: true },
    { title: "Product updates", description: "New features, improvements, and announcements", email: true, push: false },
    { title: "Security alerts", description: "Unusual sign-ins, password changes, and 2FA events", email: true, push: true }
  ].each do |pref| %>
    <div class="flex items-center justify-between px-6 py-4">
      <div>
        <p class="text-sm font-medium text-obsidian"><%= pref[:title] %></p>
        <p class="text-xs text-[var(--color-fg-1100)] mt-0.5"><%= pref[:description] %></p>
      </div>
      <div class="flex items-center gap-4">
        <label class="flex items-center gap-2 cursor-pointer">
          <input type="checkbox" <%= "checked" if pref[:email] %> class="w-4 h-4 rounded border-[var(--color-grid-500)] text-[var(--color-eggplant)] focus:ring-[var(--color-amethyst)]">
          <span class="text-xs text-[var(--color-fg-1100)]">Email</span>
        </label>
        <label class="flex items-center gap-2 cursor-pointer">
          <input type="checkbox" <%= "checked" if pref[:push] %> class="w-4 h-4 rounded border-[var(--color-grid-500)] text-[var(--color-eggplant)] focus:ring-[var(--color-amethyst)]">
          <span class="text-xs text-[var(--color-fg-1100)]">Push</span>
        </label>
      </div>
    </div>
  <% end %>
</div>

<div class="mt-4 flex justify-end">
  <button class="btn-hex btn-hex-sm rounded-[3px]">Save Preferences</button>
</div>
