<% content_for(:title, "General Settings — Starter") %>

<% content_for(:breadcrumbs) do %>
  <%= link_to "Dashboard", dashboard_path, class: "hover:text-[var(--color-fg-1200)]" %>
  <svg class="w-4 h-4 mx-1 text-[var(--color-fg-1000)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
  <span class="font-medium text-obsidian">Settings</span>
<% end %>

<% content_for(:page_header) do %>
  <h1 class="hex-h3">General Settings</h1>
  <p class="text-sm text-[var(--color-fg-1100)] mt-1">Manage your account settings and preferences</p>
<% end %>

<%# ── Settings navigation tabs ── %>
<div class="mb-8" style="border-bottom: 1px solid var(--color-grid-500);">
  <nav class="flex gap-4 -mb-px">
    <%= link_to "General", dashboard_settings_general_path, class: "pb-3 text-sm font-medium border-b-2 #{current_page?(dashboard_settings_general_path) ? 'border-[var(--color-eggplant)] text-[var(--color-eggplant)]' : 'border-transparent text-[var(--color-fg-1000)] hover:text-[var(--color-obsidian)]'} transition-colors" %>
    <%= link_to "Profile", dashboard_settings_profile_path, class: "pb-3 text-sm font-medium border-b-2 #{current_page?(dashboard_settings_profile_path) ? 'border-[var(--color-eggplant)] text-[var(--color-eggplant)]' : 'border-transparent text-[var(--color-fg-1000)] hover:text-[var(--color-obsidian)]'} transition-colors" %>
    <%= link_to "Notifications", dashboard_settings_notifications_path, class: "pb-3 text-sm font-medium border-b-2 #{current_page?(dashboard_settings_notifications_path) ? 'border-[var(--color-eggplant)] text-[var(--color-eggplant)]' : 'border-transparent text-[var(--color-fg-1000)] hover:text-[var(--color-obsidian)]'} transition-colors" %>
  </nav>
</div>

<%# ── Account details ── %>
<div class="space-y-8">
  <div class="hex-card p-6">
    <h2 class="text-base font-semibold text-obsidian mb-4">Account Details</h2>
    <form class="space-y-4 max-w-lg">
      <div>
        <label class="block text-sm font-medium text-[var(--color-fg-1200)] mb-1">Account Name</label>
        <input type="text" value="<%= current_account&.name %>" class="w-full px-3 py-2 text-sm border border-[var(--color-grid-500)] rounded-[6px] focus:ring-2 focus:ring-[var(--color-amethyst)] focus:border-[var(--color-amethyst)]">
      </div>
      <div>
        <label class="block text-sm font-medium text-[var(--color-fg-1200)] mb-1">Subdomain</label>
        <div class="flex items-center">
          <input type="text" value="<%= current_account&.subdomain %>" placeholder="your-team" class="w-full px-3 py-2 text-sm border border-[var(--color-grid-500)] rounded-l-lg focus:ring-2 focus:ring-[var(--color-amethyst)] focus:border-[var(--color-amethyst)]">
          <span class="px-3 py-2 text-sm text-[var(--color-fg-1100)] bg-[var(--color-fg-200)] border border-l-0 border-[var(--color-grid-500)] rounded-r-lg">.starter.app</span>
        </div>
      </div>
      <div>
        <label class="block text-sm font-medium text-[var(--color-fg-1200)] mb-1">Billing Email</label>
        <input type="email" value="<%= current_account&.billing_email %>" placeholder="billing@example.com" class="w-full px-3 py-2 text-sm border border-[var(--color-grid-500)] rounded-[6px] focus:ring-2 focus:ring-[var(--color-amethyst)] focus:border-[var(--color-amethyst)]">
      </div>
      <button type="submit" class="btn-hex btn-hex-sm rounded-[3px]">Save Changes</button>
    </form>
  </div>

  <%# Danger zone %>
  <% unless current_account&.personal? %>
    <div class="bg-[var(--color-fg-100)] border border-[var(--color-roseQuartz)] rounded-[12px] p-6">
      <h2 class="text-base font-semibold text-[#c24040] mb-2">Danger Zone</h2>
      <p class="text-sm text-[var(--color-fg-1200)] mb-4">Permanently delete this account and all its data. This action cannot be undone.</p>
      <button class="px-4 py-2 text-sm font-medium text-[#c24040] bg-[var(--color-fg-100)] border border-[var(--color-roseQuartz)] rounded-[6px] hover:bg-[rgba(245,192,192,0.12)] transition-colors">
        Delete Account
      </button>
    </div>
  <% end %>
</div>
