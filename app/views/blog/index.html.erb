<% content_for(:title, "Blog — Starter") %>

<section class="py-20 sm:py-28">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mx-auto text-center mb-16">
      <p class="text-sm font-semibold text-[var(--color-eggplant)] uppercase tracking-wider mb-3">Blog</p>
      <h1 class="text-3xl sm:text-4xl font-bold text-[var(--color-obsidian)]">News and updates</h1>
      <p class="mt-4 text-lg text-[var(--color-fg-1100)]">Stay informed with the latest news, insights, and updates.</p>
    </div>

    <%# Category tags %>
    <div class="flex flex-wrap items-center justify-center gap-2 mb-12">
      <% %w[All Product Engineering Tutorials Updates].each_with_index do |tag, i| %>
        <button class="px-3 py-1.5 text-sm font-medium rounded-full transition-colors <%= i == 0 ? 'bg-[var(--color-eggplant)] text-white' : 'bg-[var(--color-fg-300)] text-[var(--color-fg-1100)] hover:bg-[var(--color-fg-400)]' %>">
          <%= tag %>
        </button>
      <% end %>
    </div>

    <%# Blog post grid (placeholder posts) %>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
      <% [
        { title: "Building Multi-Tenant SaaS with Rails", tag: "Engineering", date: "Mar 14, 2026", read_time: "8 min", excerpt: "How we implemented multi-tenancy with acts_as_tenant and Pundit for production-ready team isolation." },
        { title: "Why We Chose Grape Over Rails API", tag: "Product", date: "Mar 10, 2026", read_time: "5 min", excerpt: "Our reasoning for using Grape as the API framework and how it integrates with Swagger documentation." },
        { title: "Setting Up Stripe Billing in 15 Minutes", tag: "Tutorials", date: "Mar 5, 2026", read_time: "6 min", excerpt: "A step-by-step guide to integrating Stripe subscriptions, webhooks, and the customer portal." },
        { title: "Hotwire vs React: Our Decision", tag: "Engineering", date: "Feb 28, 2026", read_time: "10 min", excerpt: "Why we went with Hotwire for a SaaS starter kit and where React still makes sense." },
        { title: "Launching Our Public Beta", tag: "Updates", date: "Feb 20, 2026", read_time: "3 min", excerpt: "We're officially in public beta. Here's what's included and what's coming next." },
        { title: "The Case for Pundit Over CanCanCan", tag: "Engineering", date: "Feb 15, 2026", read_time: "7 min", excerpt: "A deep dive into our authorization strategy and why Pundit policies scale better for SaaS." }
      ].each do |post| %>
        <article class="group">
          <%= link_to blog_path(post[:title].parameterize), class: "block" do %>
            <%# Placeholder image %>
            <div class="aspect-[16/10] bg-gradient-to-br from-gray-100 to-gray-200 rounded-xl mb-4 group-hover:shadow-lg transition-shadow overflow-hidden">
              <div class="w-full h-full flex items-center justify-center text-[var(--color-fg-900)]">
                <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg>
              </div>
            </div>

            <div class="flex items-center gap-2 mb-2">
              <span class="text-xs font-medium text-[var(--color-eggplant)] bg-[rgba(49,38,59,0.06)] px-2 py-0.5 rounded-full"><%= post[:tag] %></span>
            </div>

            <h2 class="text-lg font-semibold text-[var(--color-obsidian)] group-hover:text-[var(--color-eggplant)] transition-colors mb-2"><%= post[:title] %></h2>
            <p class="text-sm text-[var(--color-fg-1100)] line-clamp-2 mb-3"><%= post[:excerpt] %></p>

            <div class="flex items-center gap-2 text-xs text-[var(--color-fg-900)]">
              <time><%= post[:date] %></time>
              <span>&middot;</span>
              <span><%= post[:read_time] %> read</span>
            </div>
          <% end %>
        </article>
      <% end %>
    </div>
  </div>
</section>
