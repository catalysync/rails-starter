<div class="max-w-4xl mx-auto px-4 py-8">
  <div class="flex items-center justify-between mb-8">
    <h1 class="text-2xl font-bold text-gray-900">Your Accounts</h1>
    <%= link_to "New Account", new_account_path, class: "inline-flex items-center px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors" %>
  </div>

  <div class="space-y-4">
    <% @accounts.each do |account| %>
      <div class="flex items-center justify-between p-4 bg-white border border-gray-200 rounded-lg <%= 'ring-2 ring-blue-500' if account == current_account %>">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-gray-100 flex items-center justify-center text-sm font-semibold text-gray-600">
            <%= account.name.first.upcase %>
          </div>
          <div>
            <h3 class="font-medium text-gray-900"><%= account.name %></h3>
            <p class="text-sm text-gray-500">
              <%= account.personal? ? "Personal" : "Team" %>
              <% if account == current_account %>
                <span class="ml-1 text-blue-600 font-medium">&middot; Active</span>
              <% end %>
            </p>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <% if account != current_account %>
            <%= button_to "Switch", switch_account_path(account), method: :patch, class: "px-3 py-1.5 text-sm font-medium text-blue-600 bg-blue-50 rounded-lg hover:bg-blue-100 transition-colors" %>
          <% end %>
          <%= link_to "Settings", account_path(account), class: "px-3 py-1.5 text-sm font-medium text-gray-600 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
