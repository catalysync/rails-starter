<div class="max-w-4xl mx-auto px-4 py-8">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-2xl font-bold text-gray-900"><%= @account.name %></h1>
      <p class="text-sm text-gray-500 mt-1"><%= @account.personal? ? "Personal Account" : "Team Account" %></p>
    </div>

    <div class="flex items-center gap-2">
      <% if policy(@account).update? %>
        <%= link_to "Edit", edit_account_path(@account), class: "px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors" %>
      <% end %>
      <%= link_to "Members", account_memberships_path(@account), class: "px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors" %>
    </div>
  </div>

  <div class="bg-white border border-gray-200 rounded-lg p-6 space-y-4">
    <div>
      <dt class="text-sm font-medium text-gray-500">Name</dt>
      <dd class="mt-1 text-gray-900"><%= @account.name %></dd>
    </div>

    <% if @account.subdomain.present? %>
      <div>
        <dt class="text-sm font-medium text-gray-500">Subdomain</dt>
        <dd class="mt-1 text-gray-900"><%= @account.subdomain %></dd>
      </div>
    <% end %>

    <% if @account.billing_email.present? %>
      <div>
        <dt class="text-sm font-medium text-gray-500">Billing Email</dt>
        <dd class="mt-1 text-gray-900"><%= @account.billing_email %></dd>
      </div>
    <% end %>

    <div>
      <dt class="text-sm font-medium text-gray-500">Owner</dt>
      <dd class="mt-1 text-gray-900"><%= @account.owner.name %></dd>
    </div>

    <div>
      <dt class="text-sm font-medium text-gray-500">Members</dt>
      <dd class="mt-1 text-gray-900"><%= @account.memberships.active.count %></dd>
    </div>

    <div>
      <dt class="text-sm font-medium text-gray-500">Created</dt>
      <dd class="mt-1 text-gray-900"><%= @account.created_at.strftime("%B %d, %Y") %></dd>
    </div>
  </div>

  <% if policy(@account).destroy? %>
    <div class="mt-8 p-4 bg-red-50 border border-red-200 rounded-lg">
      <h3 class="text-sm font-medium text-red-800">Danger Zone</h3>
      <p class="mt-1 text-sm text-red-600">Deleting this account will remove all associated data permanently.</p>
      <%= button_to "Delete Account", account_path(@account), method: :delete,
          class: "mt-3 px-4 py-2 text-sm font-medium text-white bg-red-600 rounded-lg hover:bg-red-700 transition-colors",
          data: { turbo_confirm: "Are you sure you want to delete this account? This action cannot be undone." } %>
    </div>
  <% end %>
</div>
